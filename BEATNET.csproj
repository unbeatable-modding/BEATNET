<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDirectory Condition="'$(GameDirectory)' == '' and '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)/Steam/steamapps/common/UNBEATABLE</GameDirectory>
    <ManagedDirectory>$(GameDirectory)/UNBEATABLE_Data/Managed</ManagedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Reference Include="BepInEx" HintPath="$(GameDirectory)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDirectory)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDirectory)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Rewired_Core" HintPath="$(ManagedDirectory)/Rewired_Core.dll" Private="false" />
    <Reference Include="FMODUnity" HintPath="$(ManagedDirectory)/FMODUnity.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDirectory)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDirectory)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDirectory)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDirectory)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDirectory)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDirectory)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreFontEngineModule" HintPath="$(ManagedDirectory)/UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDirectory)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDirectory)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDirectory)/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateGameDirectory" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDirectory)' == ''" Text="Set GameDirectory to your UNBEATABLE installation." />
    <Error Condition="!Exists('$(ManagedDirectory)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll is missing. Set GameDirectory to your UNBEATABLE installation." />
    <Error Condition="!Exists('$(GameDirectory)/BepInEx/core/BepInEx.dll')" Text="BepInEx 5 is missing from the game installation." />
  </Target>
</Project>
